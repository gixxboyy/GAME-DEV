--- !u!114 &2135942679
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2135942671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d28d535c40ac4e46aada658bd838651, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCutscene
  npcDisplayName: Bos Lili
  lines:
  - gixBoySpeaks: 0
    text: Eh GixBoy! Pagi-pagi bagini ngana so bangun?
  - gixBoySpeaks: 1
    text: So, Bos Lili. Ada karja for kita?
  - gixBoySpeaks: 0
    text: Ada. Pigi ka Pom Pertaminix di Tikala. Om Wesly so siapkan jeriken di balakang kios. Tahan E for isi tiap jeriken.
  - gixBoySpeaks: 0
    text: Bawa samua ka kita pe toko, kong taru di balakang karung beras. Jang sampe Oma Ani lia!
  - gixBoySpeaks: 1
    text: ...Siap, Bos. Kita bawa capat.
  talkRadius: 3.5
  headHeight: 1.8
  hideOldBubble: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
