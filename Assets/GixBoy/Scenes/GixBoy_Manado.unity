  m_Script: {fileID: 11500000, guid: 1d28d535c40ac4e46aada658bd838651, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCutscene
  npcDisplayName: Ci Ribka
  lines:
  - gixBoySpeaks: 0
    text: Malam ini Boulevard rame, Nyong.
  - gixBoySpeaks: 1
    text: Ci Ribka, malam-malam bagini masih ada antaran?
  - gixBoySpeaks: 0
    text: Justru malam paling aman. Ambe bensin dari Pom Malalayang, bawa ka sini di Boulevard.
  - gixBoySpeaks: 0
    text: Polisi ada razia di jalan kota malam ini. Kalau dengar sirene, langsung lari. Mengerti?
  - gixBoySpeaks: 1
    text: Mengerti, Ci.
  talkRadius: 3.5
  headHeight: 1.8
  hideOldBubble: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
