  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCutscene
  npcDisplayName: Bripka Ucup
  lines:
  - gixBoySpeaks: 0
    text: Ehh, ngana! Brenti dulu.
  - gixBoySpeaks: 1
    text: Ada apa, Pak Ucup?
  - gixBoySpeaks: 0
    text: Akhir-akhir ini banyak bensin ilang dari pom. Ngana ada lia orang bawa-bawa jeriken?
  - gixBoySpeaks: 1
    text: ...Nda, Pak. Kita nda lia apa-apa.
  - gixBoySpeaks: 0
    text: Hmm. Jang sampe kita dapa ngana. Pigi jo.
  talkRadius: 3.5
  headHeight: 1.8
  hideOldBubble: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
