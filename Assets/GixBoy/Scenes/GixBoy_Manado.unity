  m_Script: {fileID: 11500000, guid: 1d28d535c40ac4e46aada658bd838651, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCutscene
  npcDisplayName: Oma Ani
  lines:
  - gixBoySpeaks: 0
    text: Nyong! So makang ngana?
  - gixBoySpeaks: 1
    text: Balom, Oma.
  - gixBoySpeaks: 0
    text: Ambe nasi kuning ini. Nda usah bayar.
  - gixBoySpeaks: 1
    text: Makase banyak, Oma...
  - gixBoySpeaks: 0
    text: Ingat, Nyong. Biar susah, jang ambe yang bukan ngana pe hak.
  talkRadius: 3.5
  headHeight: 1.8
  hideOldBubble: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
