--- !u!114 &1244513
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1244511}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d89a9356dc30134e8f00bb358c23703, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionManager
  missions:
  - title: Bos Lili (Pagi)
    boss: {fileID: 2135942679}
    station: {fileID: 1400240093}
    stationName: Pom Pertaminix Tikala
    time: 0
    cansRequired: 3
    reward: 100000
    reminderLines:
    - gixBoySpeaks: 0
      text: Mana jeriken? Pigi ka Pom Pertaminix Tikala, isi di balakang kios.
    - gixBoySpeaks: 1
      text: Iyo, Bos. Kita pigi skarang.
    thanksLines:
    - gixBoySpeaks: 0
      text: So dapa? Bagus, Nyong!
    - gixBoySpeaks: 1
      text: Tiga jeriken, Bos Lili.
    - gixBoySpeaks: 0
      text: Taru di balakang karung beras. Ini ngana pe doi.
    - gixBoySpeaks: 0
      text: Masih pagi, Bos Luis di Tikala juga cari ngana.
    doneLines:
    - gixBoySpeaks: 0
      text: Makase, Nyong. Pigi ka Bos Luis di Tikala.
    briefLines:
    - gixBoySpeaks: 0
      text: Eh GixBoy! Pagi-pagi bagini ngana so bangun?
    - gixBoySpeaks: 1
      text: So, Bos Lili. Ada karja for kita?
    - gixBoySpeaks: 0
      text: Ada. Pigi ka Pom Pertaminix di Tikala. Om Wesly so siapkan jeriken di balakang kios. Tahan E for isi tiap jeriken.
    - gixBoySpeaks: 0
      text: Bawa samua ka kita pe toko, kong taru di balakang karung beras. Jang sampe Oma Ani lia!
    - gixBoySpeaks: 1
      text: ...Siap, Bos. Kita bawa capat.
  - title: Bos Luis (Pagi)
    boss: {fileID: 702958184}
    station: {fileID: 197784300}
    stationName: Pom Pertaminix Boulevard
    time: 0
    cansRequired: 3
    reward: 125000
    reminderLines:
    - gixBoySpeaks: 0
      text: Bensin dari Pom Boulevard mana? Orang-orang so antre!
    - gixBoySpeaks: 1
      text: Sabar, Bos.
    thanksLines:
    - gixBoySpeaks: 0
      text: Akhirnya! Ini cukup for tiga hari eceran.
    - gixBoySpeaks: 1
      text: ...Dorang mo beli tiga kali lipat, Bos?
    - gixBoySpeaks: 0
      text: Bukan ngana pe urusan. Ini doi.
    - gixBoySpeaks: 0
      text: Siang nanti Bos Bruno di pelabuhan cari ngana.
    doneLines:
    - gixBoySpeaks: 0
      text: Pigi ka pelabuhan. Bos Bruno so tunggu.
    briefLines:
    - gixBoySpeaks: 0
      text: GixBoy! Botol-botol eceran so kosong samua.
    - gixBoySpeaks: 1
      text: Orang-orang di luar so antre panjang, Bos Luis.
    - gixBoySpeaks: 0
      text: Makanya! Ambe bensin di Pom Boulevard. Jauh, mar di sana stok paling banyak. Pake kita pe pickup. Torang jual tiga kali lipat.
    - gixBoySpeaks: 1
      text: Tiga kali lipat? Dorang so susah, Bos...
    - gixBoySpeaks: 0
      text: Itu bukan ngana pe urusan. Hati-hati, Bripka Ucup ada jaga di pom itu. Pigi jo!
  - title: Bos Bruno (Siang)
    boss: {fileID: 1109177011}
    station: {fileID: 457274692}
    stationName: Pom Pertaminix Pasar Bersehati
    time: 1
    cansRequired: 4
    reward: 175000
    reminderLines:
    - gixBoySpeaks: 0
      text: Kapal so mo berangkat! Jeriken dari Pom Pasar Bersehati mana?
    thanksLines:
    - gixBoySpeaks: 0
      text: Bagus. Kapal bisa berangkat skarang.
    - gixBoySpeaks: 1
      text: Para nelayan di dermaga so lama nda melaut, Bos...
    - gixBoySpeaks: 0
      text: Jang pikir dorang. Ini ngana pe doi.
    - gixBoySpeaks: 0
      text: Malam nanti Ci Ribka di Boulevard cari ngana.
    doneLines:
    - gixBoySpeaks: 0
      text: Malam ini pigi ka Boulevard.
    briefLines:
    - gixBoySpeaks: 0
      text: Kapal so tunggu dari tadi, GixBoy.
    - gixBoySpeaks: 1
      text: Bos Bruno, bensin ini mo bawa ka mana?
    - gixBoySpeaks: 0
      text: Jang banyak tanya. Angkat jeriken dari Pom Pasar Bersehati, bawa ka dermaga sini. Jauh, jadi bawa pickup.
    - gixBoySpeaks: 0
      text: Siang-siang ada dua polisi jaga di pom itu. Jang sampe dorang lia ngana isi jeriken.
    - gixBoySpeaks: 1
      text: ...Iyo, Bos.
  - title: Ci Ribka (Malam)
    boss: {fileID: 696441357}
    station: {fileID: 169368710}
    stationName: Pom Pertaminix Malalayang
    time: 2
    cansRequired: 4
    reward: 200000
    reminderLines:
    - gixBoySpeaks: 0
      text: Nyong, bensin dari Pom Malalayang? Malam nda lama.
    thanksLines:
    - gixBoySpeaks: 0
      text: Rapi skali karja ngana.
    - gixBoySpeaks: 1
      text: Ci, sebenarnya bensin ini ka mana samua?
    - gixBoySpeaks: 0
      text: Ka gudang Opa Hendrik di Malalayang.
    - gixBoySpeaks: 0
      text: Pigi ketemu dia. Dia mo kase ngana tantangan terakhir.
    doneLines:
    - gixBoySpeaks: 0
      text: Opa Hendrik so tunggu di Malalayang.
    briefLines:
    - gixBoySpeaks: 0
      text: Malam ini Boulevard rame, Nyong.
    - gixBoySpeaks: 1
      text: Ci Ribka, malam-malam bagini masih ada antaran?
    - gixBoySpeaks: 0
      text: Justru malam paling aman. Ambe bensin dari Pom Malalayang, bawa ka sini di Boulevard.
    - gixBoySpeaks: 0
      text: Polisi ada razia di jalan kota malam ini. Kalau dengar sirene, langsung lari. Mengerti?
    - gixBoySpeaks: 1
      text: Mengerti, Ci.
  - title: Opa Hendrik (Malam)
    boss: {fileID: 34246323}
    station: {fileID: 1008047990}
    stationName: Pom Pertaminix Pelabuhan
    time: 2
    cansRequired: 5
    reward: 500000
    reminderLines:
    - gixBoySpeaks: 0
      text: Kumpul bensin dari Pom Pelabuhan, Nyong. Samua.
    thanksLines:
    - gixBoySpeaks: 0
      text: Samua so lengkap...
    - gixBoySpeaks: 0
      text: Ngana so kerja bagus, Nyong. Mulai hari ini, ngana bukan lagi cuma orang suruhan.
    - gixBoySpeaks: 0
      text: Ngana so jadi bagian dari torang.
    - gixBoySpeaks: 1
      text: ...
    - gixBoySpeaks: 1
      text: (Biar susah, jang ambe yang bukan ngana pe hak...)
    doneLines:
    - gixBoySpeaks: 0
      text: Torang pe keluarga, Nyong.
    briefLines:
    - gixBoySpeaks: 0
      text: Jadi ngana ini GixBoy... Kita so dengar banyak tentang ngana, Nyong.
    - gixBoySpeaks: 1
      text: Opa Hendrik? Jadi samua bos... karja for Opa?
    - gixBoySpeaks: 0
      text: Bos Lili, Bos Luis, Bos Bruno, Ci Ribka. Samua torang pe orang.
    - gixBoySpeaks: 0
      text: 'Tantangan terakhir: kumpul bensin dari Pom Pelabuhan. Di sana polisi paling banyak, Nyong. Bawa samua ka kita pe gudang.'
    - gixBoySpeaks: 0
      text: Kalau ngana berhasil, ngana nda akan sandiri lagi.
    - gixBoySpeaks: 1
      text: ...Kita mo kase selesai, Opa.
  omaAni: {fileID: 828066143}
  police: {fileID: 1739692189}
  marker: {fileID: 1073190195}
  spawnPoint: {fileID: 1656134578}
  lockedLines:
  - gixBoySpeaks: 0
    text: Belum waktunya, Nyong. Nanti kita cari ngana.
