  m_Script: {fileID: 11500000, guid: 1d28d535c40ac4e46aada658bd838651, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCutscene
  npcDisplayName: Bos Bruno
  lines:
  - gixBoySpeaks: 0
    text: Kapal so tunggu dari tadi, GixBoy.
  - gixBoySpeaks: 1
    text: Bos Bruno, bensin ini mo bawa ka mana?
  - gixBoySpeaks: 0
    text: Jang banyak tanya. Angkat jeriken dari Pom Pasar Bersehati, bawa ka dermaga sini. Jauh, jadi bawa pickup.
  - gixBoySpeaks: 0
    text: Siang-siang ada dua polisi jaga di pom itu. Jang sampe dorang lia ngana isi jeriken.
  - gixBoySpeaks: 1
    text: ...Iyo, Bos.
  talkRadius: 3.5
  headHeight: 1.8
  hideOldBubble: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
