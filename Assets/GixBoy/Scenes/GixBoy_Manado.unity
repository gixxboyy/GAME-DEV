--- !u!114 &34246323
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 34246315}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d28d535c40ac4e46aada658bd838651, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueCutscene
  npcDisplayName: Opa Hendrik
  lines:
  - gixBoySpeaks: 0
    text: Jadi ngana ini GixBoy... Kita so dengar banyak tentang ngana, Nyong.
  - gixBoySpeaks: 1
    text: Opa Hendrik? Jadi samua bos... karja for Opa?
  - gixBoySpeaks: 0
    text: Bos Lili, Bos Luis, Bos Bruno, Ci Ribka. Samua torang pe orang.
  - gixBoySpeaks: 0
    text: 'Tantangan terakhir: kumpul bensin dari Pom Pelabuhan. Di sana polisi paling banyak, Nyong. Bawa samua ka kita pe gudang.'
  - gixBoySpeaks: 0
    text: Kalau ngana berhasil, ngana nda akan sandiri lagi.
  - gixBoySpeaks: 1
    text: ...Kita mo kase selesai, Opa.
  talkRadius: 3.5
  headHeight: 1.8
  hideOldBubble: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
